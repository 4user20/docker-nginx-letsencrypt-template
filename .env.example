# Application
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://portfolio_user:password@postgres:5432/portfolio_db
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=change-this-secure-password
POSTGRES_DB=portfolio_db

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=generate-random-string-min-32-chars
JWT_REFRESH_SECRET=generate-different-random-string-min-32-chars

# SSL Configuration
DOMAIN=yourdomain.com
EMAIL=your@email.com
STAGING=0  # Set to 1 for Let's Encrypt staging

# Application URLs
APP_WEB_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=1000

# Monitoring
ENABLE_METRICS=true
METRICS_PATH=/metrics
HEALTH_CHECK_PATH=/health
