{
  "name": "portfolio-app",
  "version": "1.0.0",
  "description": "Portfolio application with Fastify and TypeScript",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && esbuild src/server.ts --bundle --platform=node --target=node20 --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration"
  },
  "keywords": [
    "fastify",
    "typescript",
    "portfolio",
    "devops"
  ],
  "author": "DevOps Engineer",
  "license": "MIT",
  "dependencies": {
    "fastify": "^4.25.0",
    "fastify-plugin": "^4.5.1",
    "@prisma/client": "^5.7.0",
    "redis": "^4.6.12",
    "zod": "^3.22.4",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.11",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "esbuild": "^0.19.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "prisma": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
